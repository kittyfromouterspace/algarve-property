---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteBase = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const ogImage = new URL('/images/og-image.jpg', siteBase).toString();
const ogImageAlt = 'Aerial view of Quinta Fonte do Palheiro estate in the Algarve hills';
const siteName = 'Quinta Fonte do Palheiro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Quinta Fonte do Palheiro" />
    <meta name="theme-color" content="#183129" />
    <meta name="msapplication-TileColor" content="#183129" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp, etc.) -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content={canonicalURL.hostname} />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- WhatsApp uses Open Graph -->
    <!-- The og:image above + og:title + og:description covers WhatsApp sharing -->

    <!-- Performance -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wdth,wght@0,75..100,400..700;1,75..100,400..700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />

    <title>{title}</title>

    <!-- Structured Data: Real Estate Listing -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "RealEstateListing",
      "name": siteName,
      "description": description,
      "url": canonicalURL.toString(),
      "image": ogImage,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Salir",
        "addressRegion": "Algarve",
        "addressCountry": "PT"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "37.21",
        "longitude": "-8.00"
      },
      "offers": {
        "@type": "Offer",
        "price": "890000",
        "priceCurrency": "EUR",
        "availability": "https://schema.org/InStock"
      }
    })} />

    <!-- Structured Data: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": siteName,
      "url": canonicalURL.toString(),
      "logo": ogImage
    })} />

    <!-- Structured Data: Image Gallery -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ImageGallery",
      "name": `${siteName} - Property Gallery`,
      "description": "Photo gallery of Quinta Fonte do Palheiro, a unique rural property in the Algarve interior.",
      "url": new URL('#gallery', canonicalURL).toString()
    })} />
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-dBK19tlt6hLXvwZHMZJEW.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <a
      class="whatsapp-float"
      href="https://wa.me/351911795594?text=Ol%C3%A1%20Lenz%2C%20I%27d%20like%20a%20live%20video%20walkthrough%20of%20Quinta%20Fonte%20do%20Palheiro."
      target="_blank"
      rel="noopener"
      aria-label="Chat on WhatsApp about Quinta Fonte do Palheiro"
    >
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.4 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.2-.7.6-.9 1 0 2.4.6 3.5a11.6 11.6 0 0 0 4.5 4c.6.3 1.1.4 1.5.6.6.2 1.2.2 1.6.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.5-.2Z"/></svg>
      <span>WhatsApp us</span>
    </a>
  </body>
</html>

<style is:global>
  :root {
    --ink: #17362d;
    --ink-deep: #0d251e;
    --paper: #fcfaf6;
    --sand: #eee7dc;
    --clay: #b8563c;
    --ochre: #e3bd78;
    --line: rgba(23, 54, 45, .16);
    --font-display: 'Instrument Serif', Georgia, serif;
    --font-body: 'Instrument Sans', 'Segoe UI', sans-serif;
    --font-mono: 'Instrument Sans', 'Segoe UI', sans-serif;
    --page-edge: max(1.5rem, calc((100vw - 1440px) / 2));
    /* Backwards-compatible aliases for the gallery component. */
    --color-primary: var(--ink);
    --color-accent: var(--ochre);
    --color-cream: var(--paper);
    --color-warm: var(--sand);
    --color-text: var(--ink);
    --color-text-light: rgba(24, 49, 41, .68);
    --color-white: var(--paper);
    --font-heading: var(--font-display);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    color: var(--ink);
    line-height: 1.65;
    background: var(--paper);
    font-optical-sizing: auto;
    touch-action: manipulation;
    -webkit-tap-highlight-color: rgba(213, 172, 98, .35);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.02;
    text-wrap: balance;
  }

  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, summary:focus-visible, [tabindex]:focus-visible {
    outline: 2px solid var(--ochre);
    outline-offset: 3px;
  }

  .skip-link { position: absolute; left: 1rem; top: -4rem; z-index: 100; padding: .8rem 1.1rem; background: var(--ochre); color: var(--ink-deep); font: 600 .66rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; transition: top .2s ease; }
  .skip-link:focus-visible { top: 1rem; }

  ::selection {
    background: var(--ochre);
    color: var(--ink-deep);
  }

  .eyebrow { color: var(--clay); font: 650 .72rem/1.4 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .eyebrow--light { color: var(--ochre); }
  .button { display: inline-flex; align-items: center; gap: .75rem; padding: .95rem 1.2rem; border: 1px solid var(--ink); border-radius: .25rem; color: var(--ink); font: 650 .77rem/1.2 var(--font-mono); letter-spacing: .055em; text-transform: uppercase; transition: transform .25s ease, background .25s ease, color .25s ease, border-color .25s ease; }
  .button:hover { transform: translateY(-.18rem); background: var(--ink); color: var(--paper); }
  .button--ochre { border-color: var(--ochre); background: var(--ochre); color: var(--ink-deep); }
  .button--ochre:hover { border-color: var(--paper); background: var(--paper); color: var(--ink-deep); }
  .button--paper { border-color: var(--paper); color: var(--paper); }
  .button--paper:hover { background: var(--paper); color: var(--ink); }
  .whatsapp-float { position: fixed; z-index: 50; right: 1.25rem; bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px)); display: inline-flex; align-items: center; gap: .6rem; padding: .8rem 1.1rem; border-radius: 999px; background: #178349; color: #fff; font: 650 .7rem/1 var(--font-mono); letter-spacing: .055em; text-transform: uppercase; box-shadow: 0 .75rem 2rem rgba(0,0,0,.28); transition: transform .2s ease, box-shadow .2s ease; }
  .whatsapp-float:hover { transform: translateY(-2px); box-shadow: 0 1rem 2.4rem rgba(0,0,0,.32); color: #fff; }
  @media (max-width: 700px) { .whatsapp-float span { display: none; } .whatsapp-float { padding: .9rem; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; } }
</style>
