---
interface Props {
  ctaHref?: string;
}

const { ctaHref = '/#enquire' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { href: '/', label: 'The estate' },
  { href: '/retreat-venue', label: 'Retreats' },
  { href: '/rural-tourism-business', label: 'Rural tourism' },
  { href: '/independent-living', label: 'Independent living' },
  { href: '/buyer-facts', label: 'Buyer facts' },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="wordmark" aria-label="Quinta Fonte do Palheiro home">
      <span class="wordmark__mark" aria-hidden="true">FP</span>
      <span>
        <strong>Fonte do Palheiro</strong>
        <small>Estate dossier · Algarve</small>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={link.href} class:list={{ active: path === link.href.replace(/\/$/, '') }}>{link.label}</a>
      ))}
    </nav>

    <a href={ctaHref} class="header-cta">Book a video tour <span aria-hidden="true">↗</span></a>

    <details class="mobile-menu">
      <summary aria-label="Open menu"><span></span><span></span></summary>
      <nav aria-label="Mobile navigation">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href={ctaHref} class="mobile-menu__cta">Book a video tour ↗</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    color: var(--paper);
  }
  .site-header__inner {
    width: min(100% - 3rem, 1540px);
    margin: 1.2rem auto 0;
    min-height: 5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    padding: 0 1.15rem;
    border: 1px solid rgba(252,250,246,.27);
    border-radius: .35rem;
    background: rgba(13,37,30,.28);
    box-shadow: 0 .5rem 2rem rgba(8,23,18,.12);
    backdrop-filter: blur(14px);
  }
  .wordmark { display: inline-flex; align-items: center; gap: .75rem; width: max-content; }
  .wordmark__mark {
    display: grid; place-items: center; width: 2.15rem; height: 2.15rem;
    border: 1px solid currentColor; border-radius: 50%; font: 650 .64rem/1 var(--font-mono);
    letter-spacing: .04em;
  }
  .wordmark strong, .wordmark small { display: block; }
  .wordmark strong { font-family: var(--font-display); font-size: 1.42rem; line-height: .85; font-weight: 400; letter-spacing: -.015em; }
  .wordmark small { margin-top: .35rem; font: 550 .62rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; opacity: .76; }
  .site-header__nav { display: flex; justify-content: center; gap: 1.65rem; }
  .site-header__nav a { font: 550 .7rem/1 var(--font-mono); letter-spacing: .055em; text-transform: uppercase; opacity: .8; padding: .45rem 0; border-bottom: 1px solid transparent; }
  .site-header__nav a:hover, .site-header__nav a.active { opacity: 1; border-color: currentColor; }
  .header-cta { justify-self: end; display: inline-flex; gap: .5rem; align-items: center; padding: .72rem .9rem; border: 1px solid rgba(255,255,255,.5); border-radius: .2rem; font: 650 .68rem/1 var(--font-mono); letter-spacing: .045em; text-transform: uppercase; transition: background .25s, color .25s, border-color .25s; }
  .header-cta:hover { color: var(--ink); background: var(--paper); }
  .mobile-menu { display: none; }
  @media (max-width: 1050px) { .site-header__nav { display: none; } .site-header__inner { grid-template-columns: 1fr auto; } .mobile-menu { display: block; } .header-cta { display: none; } }
  @media (max-width: 700px) {
    .site-header__inner { width: min(100% - 2rem, 1540px); min-height: 4.6rem; margin-top: .85rem; padding: 0 .75rem; }
    .wordmark strong { font-size: 1.18rem; }
    .wordmark small { font-size: .56rem; }
    .mobile-menu { position: relative; }
    .mobile-menu summary { list-style: none; width: 2.4rem; height: 2.4rem; display: grid; place-content: center; gap: .35rem; border: 1px solid rgba(255,255,255,.45); border-radius: .2rem; cursor: pointer; }
    .mobile-menu summary::-webkit-details-marker { display:none; }
    .mobile-menu summary span { width: .85rem; height: 1px; background: currentColor; display: block; }
    .mobile-menu nav { position: absolute; top: calc(100% + .65rem); right: 0; padding: 1.25rem; width: min(78vw, 19rem); border-radius: .3rem; background: var(--ink); border: 1px solid rgba(255,255,255,.2); box-shadow: 0 1rem 3rem rgba(0,0,0,.25); }
    .mobile-menu nav a { display: block; padding: .8rem 0; font: 550 .74rem/1 var(--font-mono); letter-spacing: .055em; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,.14); }
    .mobile-menu nav a.mobile-menu__cta { margin-top: .75rem; border: 1px solid var(--ochre); padding: .75rem; color: var(--ochre); text-align: center; }
  }
</style>
