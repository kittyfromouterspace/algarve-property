---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You - Fonte do Palheiro Estate" description="Thank you for your inquiry">
  <main id="main" class="success-page">
    <div class="success-content">
      <p class="eyebrow">Request received</p>
      <h1>Thank you.<br /><em>We’ll be in touch soon.</em></h1>
      <p>Your request is with us. We will confirm a visit or send the information you asked for by email within 48 hours.</p>
      <a href="/" class="button button--ochre">Return to the estate <span aria-hidden="true">↗</span></a>
    </div>
  </main>
</Layout>

<style>
  .success-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--paper);
    background: radial-gradient(circle at 72% 25%, rgba(227,189,120,.18), transparent 26rem), var(--ink);
    padding: 2rem;
  }
  .success-content {
    max-width: 46rem;
    text-align: center;
  }
  h1 {
    margin: 1rem 0 1.5rem;
    font: 400 clamp(3.7rem, 8vw, 7rem)/.9 var(--font-display);
    letter-spacing: -.015em;
  }
  h1 em {
    color: var(--ochre);
    font-weight: 400;
  }
  p {
    max-width: 32rem;
    margin: 0 auto 2rem;
    color: rgba(252,250,246,.8);
    font-size: 1.05rem;
  }
</style>
