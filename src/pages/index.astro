---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import EnquiryPanel from '../components/EnquiryPanel.astro';
import { estateFacts, opportunities, property } from '../data/property';
---

<Layout title="Skip the ruin: 2.5 ha Algarve estate, €890,000 | Quinta Fonte do Palheiro" description="2.5 ha ridge-line estate with 2 furnished houses, pool, meditation house, 500 m² commercial shell, own water, 45 min from Faro. For retreats, rural tourism or freer living. Book a live video walkthrough.">
  <SiteHeader ctaHref="#enquire" />
  <main id="main">
    <section class="hero">
      <img class="hero__image" src="/images/areal1.jpg" alt="Aerial view of Quinta Fonte do Palheiro and the Algarve hills" width="1600" height="1200" fetchpriority="high" decoding="async" />
      <div class="hero__veil"></div>
      <div class="hero__content">
        <p class="eyebrow eyebrow--light">Salir, Loulé · Algarve · €890,000</p>
        <h1>Skip the ruin.<br /><em>Start living in week one.</em></h1>
        <p class="hero__statement">Quinta Fonte do Palheiro is a 2.5-hectare ridge-line estate with two furnished houses, a pool, a meditation house, a 500&nbsp;m² commercial shell and its own water, 45 minutes from Faro. Built for retreat hosts, tourism operators or a freer life.</p>
        <div class="hero__actions">
          <a class="button button--ochre" href="#enquire">Book a live video walkthrough <span aria-hidden="true">↗</span></a>
          <a class="hero__quiet-link" href="#possibilities">Which future fits you? <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero__reassurance">Video tours weekly · reply within 48 hours · buyer-facts brief before you fly</p>
      </div>
      <div class="hero__price"><span>Asking price</span><strong>€890,000</strong></div>
      <div class="hero__location">37° N · Algarve hills<br />45 min · Faro airport</div>
    </section>

    <section class="fact-strip" aria-label="Estate facts">
      <p>Estate brief <span aria-hidden="true">/</span> 2026</p>
      {estateFacts.map((fact) => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
    </section>

    <section class="manifesto">
      <div class="manifesto__label"><p class="eyebrow">Stop scrolling villas</p><span>01</span></div>
      <div class="manifesto__copy">
        <h2>This is not<br />a villa with extras.</h2>
        <p>You know the feeling: every portal shows you “3-bed villa with pool, close to beach,” and none of it fits a retreat venue, a tourism business or a freer rural life. Quinta Fonte do Palheiro was never a beach villa. It is 10+ buildings, its own water and a commercially zoned 500&nbsp;m² shell on a ridge the estate owns the view from. So the question is not how many bathrooms. It is <em>what will you make possible here?</em></p>
        <p class="manifesto__cta"><a class="button" href="#enquire">See it live before you fly <span aria-hidden="true">↗</span></a></p>
      </div>
      <figure class="manifesto__image"><img src="/images/main-house-outside-view2.JPG" alt="The main house with Algarve hills beyond" width="1600" height="1201" loading="lazy" decoding="async" /><figcaption>Hills to coastline · outlook you own</figcaption></figure>
    </section>

    <section id="possibilities" class="possibilities">
      <header class="possibilities__header"><p class="eyebrow">Choose your lens</p><h2>One estate.<br /><em>Three ways to earn it back.</em></h2><p>The place is the same. The maths, the questions and the walkthrough are different. Pick the future you want to price. We will show you those exact rooms live.</p></header>
      <div class="possibilities__list">
        {opportunities.map((opportunity, index) => (
          <a class:list={['possibility', { 'possibility--reverse': index === 1 }]} href={`/${opportunity.slug}`}>
            <div class="possibility__image"><img src={opportunity.image} alt={opportunity.imageAlt} width={opportunity.imageWidth} height={opportunity.imageHeight} loading="lazy" decoding="async" /><span>{opportunity.number}</span></div>
            <div class="possibility__copy"><p class="eyebrow">{opportunity.label}</p><h3>{opportunity.cardTitle}</h3><p>{opportunity.summary}</p><ul>{opportunity.facts.slice(0, 3).map((fact) => <li>{fact}</li>)}</ul><span class="possibility__link">Walk this route live <b aria-hidden="true">↗</b></span></div>
          </a>
        ))}
      </div>
    </section>

    <section class="steps" aria-label="How it works">
      <div class="steps__label"><p class="eyebrow">From click to sunset</p><span>03</span></div>
      <div class="steps__copy">
        <h2>See it as it really is<br />in three steps.</h2>
        <ol>
          <li><strong>1: Pick your lens.</strong> Retreat, rural tourism or independent living. Each page shows the rooms and numbers that matter for that plan.</li>
          <li><strong>2: Book a live video walkthrough.</strong> We film the exact guest rooms, terraces, factory shell and water systems you ask about. No staged edit.</li>
          <li><strong>3: Visit with the facts in hand.</strong> Read the 6 buyer facts first, then fly to Faro knowing the licensing, water and access questions to ask.</li>
        </ol>
        <a class="button button--ochre" href="#enquire">Start with step 2: book the walkthrough <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="estate-assembly">
      <div class="estate-assembly__heading"><p class="eyebrow eyebrow--light">The physical estate</p><h2>Everything already<br />has a place.</h2><p>Not a floor plan, but a set of settings: arrive in a furnished house, gather by the pool at sunset, make in the workshop, rest in the meditation house and grow on the terraces. Furnished down to the cutlery.</p><a href="#enquire" class="button button--paper">Ask to see your setting live <span aria-hidden="true">↗</span></a></div>
      <div class="estate-assembly__photos">
        <figure class="estate-assembly__photo estate-assembly__photo--pool"><img src="/images/pool4.JPG" alt="Poolside terrace overlooking the hills" width="1600" height="900" loading="lazy" decoding="async" /><figcaption>Gather · poolside terrace</figcaption></figure>
        <figure class="estate-assembly__photo estate-assembly__photo--yoga"><img src="/images/meditation-house1.jpg" alt="Dedicated meditation house in the gardens" width="900" height="1600" loading="lazy" decoding="async" /><figcaption>Rest · meditation house</figcaption></figure>
        <figure class="estate-assembly__photo estate-assembly__photo--factory"><img src="/images/wood-workshop.jpg" alt="Wood workshop with tools and benches" width="1600" height="902" loading="lazy" decoding="async" /><figcaption>Make · wood workshop</figcaption></figure>
      </div>
    </section>

    <section class="proof">
      <div class="proof__figure"><img src="/images/overview-plan1.jpg" alt="Estate overview plan" width="4032" height="2268" loading="lazy" decoding="async" /><span>Estate overview plan</span></div>
      <div class="proof__content"><p class="eyebrow">The questions that matter</p><h2>A beautiful idea<br />should survive<br /><em>tough questions.</em></h2><p>Commercial vs. private zoning, own water, hillside terraces, access and internet. We put the deal-killers on the table early, so the buyers who fly are the buyers who stay. Read the 6 buyer facts in five minutes.</p><div class="proof__actions"><a href="/buyer-facts" class="button">Read the 6 buyer facts <span aria-hidden="true">↗</span></a><a href="#enquire" class="proof__quiet-link">Or ask us directly ↗</a></div></div>
    </section>

    <section class="objections" aria-label="Honest answers">
      <header class="objections__header"><p class="eyebrow">Heard it before? Good.</p><h2>The four objections,<br />answered honestly.</h2></header>
      <div class="objections__grid">
        <article><h3>“Too far from the beach?”</h3><p>40 minutes to the coast, 45 to Faro. Retreat guests and rural travellers come for the hills, and you are the venue they fly to, not the villa they walk from.</p></article>
        <article><h3>“Is the land too steep?”</h3><p>Parts are. The terraces that count for growing, gathering or building are established and walkable. Judge them on live video, not on a contour map.</p></article>
        <article><h3>“Can I legally operate here?”</h3><p>Factory: commercially zoned. Houses and terraces: private-zoned today. Bring your format and confirm the route with Loulé Council. We show you which building is which first.</p></article>
        <article><h3>“What about water and power?”</h3><p>Own water source, 3-phase power throughout, 11&nbsp;kW EV charger installed. Ask for seasonal water performance and running costs on your call.</p></article>
      </div>
      <a href="/buyer-facts" class="objections__link">All six buyer facts with the fine print ↗</a>
    </section>

    <section class="location-band"><p class="eyebrow">A quieter Algarve</p><div><h2>Salir sits beyond<br />the resort noise.</h2><p>Malhão, near Salir: 45 minutes from Faro Airport for guest logistics, around 40 minutes from the coast, 15 minutes to the supermarket. Rural enough for silence and close enough for business, with a ridge-line sunset no one can build in front of.</p><a href="#enquire" class="location-band__cta">Come and watch one sunset ↗</a></div><span class="location-band__marker">Salir<br /><i>37.21° N</i></span></section>
    <Gallery images={property.gallery} />
    <EnquiryPanel />
  </main>
  <SiteFooter />
</Layout>

<style>
  .hero { min-height: min(56rem, 100svh); position: relative; isolation: isolate; display: flex; align-items: end; overflow: hidden; padding: 10rem var(--page-edge) 5.5rem; color: var(--paper); background: var(--ink); }
  .hero__image { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 56%; animation: reveal-image 1.6s cubic-bezier(.2,.75,.2,1) both; }
  .hero__veil { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgba(8,28,21,.88), rgba(8,28,21,.46) 54%, rgba(8,28,21,.1)), linear-gradient(0deg, rgba(8,28,21,.64), transparent 50%); }
  .hero__content { max-width: 47rem; animation: rise-in 1.1s .25s cubic-bezier(.2,.75,.2,1) both; }
  .hero h1 { margin: 1.25rem 0 1.5rem; font-size: clamp(4.2rem, 8vw, 8.2rem); line-height: .88; letter-spacing: -.018em; font-weight: 400; }
  .hero h1 em { color: var(--ochre); font-weight: 400; }
  .hero__statement { max-width: 38rem; font-size: clamp(1.02rem, 1.3vw, 1.18rem); line-height: 1.62; color: rgba(252,250,246,.9); }
  .hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.2rem 1.6rem; margin-top: 2.15rem; }
  .hero__quiet-link { color: var(--paper); font: 500 .64rem/1.4 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; border-bottom: 1px solid rgba(246,242,231,.48); padding-bottom: .2rem; }
  .hero__quiet-link:hover { color: var(--ochre); border-color: var(--ochre); }
  .hero__reassurance { margin-top: 1.4rem; font: 500 .6rem/1.6 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; color: rgba(246,242,231,.66); }
  .hero__price { position: absolute; right: var(--page-edge); bottom: 5.5rem; padding: 1rem 0 1rem 1.2rem; border-left: 1px solid var(--ochre); text-align: right; background: linear-gradient(90deg, transparent, rgba(13,37,30,.24)); }
  .hero__price span, .hero__price strong { display: block; }
  .hero__price span, .hero__location { font: 500 .58rem/1.5 var(--font-mono); letter-spacing: .11em; text-transform: uppercase; }
  .hero__price strong { margin-top: .25rem; color: var(--ochre); font: 400 clamp(1.7rem, 2.6vw, 2.6rem)/1 var(--font-display); letter-spacing: -.04em; }
  .hero__location { position: absolute; left: var(--page-edge); bottom: 1.25rem; opacity: .75; }
  .fact-strip { background: var(--ochre); color: var(--ink-deep); min-height: 8rem; display: grid; grid-template-columns: 1.35fr repeat(4, 1fr); align-items: stretch; padding: 0 var(--page-edge); }
  .fact-strip > p, .fact-strip > div { padding: 1.3rem 1rem; display: flex; flex-direction: column; justify-content: center; border-left: 1px solid rgba(15,33,28,.28); }
  .fact-strip > p { padding-left: 0; border: 0; align-items: start; font: 500 .59rem/1.7 var(--font-mono); letter-spacing: .11em; text-transform: uppercase; }
  .fact-strip > p span { opacity: .5; margin: .2rem 0; }
  .fact-strip strong { font: 400 clamp(2rem, 2.6vw, 2.8rem)/.9 var(--font-display); letter-spacing: -.04em; }
  .fact-strip span { margin-top: .35rem; font: 500 .57rem/1.1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .manifesto { display: grid; grid-template-columns: .6fr 1.05fr .82fr; gap: clamp(2rem, 5vw, 7rem); align-items: start; padding: clamp(5.5rem, 11vw, 12rem) var(--page-edge); }
  .manifesto__label { display: flex; justify-content: space-between; gap: 1rem; }
  .manifesto__label span { font: 500 .59rem/1 var(--font-mono); letter-spacing: .1em; opacity: .5; }
  .manifesto__copy h2 { max-width: 42rem; font-size: clamp(2.9rem, 4.8vw, 5.1rem); line-height: .94; letter-spacing: -.015em; font-weight: 400; }
  .manifesto__copy p { max-width: 37rem; margin: 1.7rem 0 0; font-size: 1.06rem; line-height: 1.7; color: rgba(23,54,45,.8); }
  .manifesto__copy em { color: var(--clay); font-family: var(--font-display); font-size: 1.25em; font-style: normal; }
  .manifesto__cta { margin-top: 2rem; }
  .manifesto__image { margin-top: 4.5rem; position: relative; }
  .manifesto__image::before { content: ''; position: absolute; z-index: -1; inset: -1rem 1rem 1rem -1rem; border: 1px solid var(--clay); border-radius: .35rem; }
  .manifesto__image img { aspect-ratio: 4/5; width: 100%; border-radius: .25rem; object-fit: cover; }
  .manifesto__image figcaption { margin-top: .65rem; color: var(--clay); font: 500 .57rem/1.3 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .possibilities { padding: clamp(5.5rem, 10vw, 11rem) var(--page-edge); background: var(--sand); }
  .possibilities__header { max-width: 54rem; padding-bottom: clamp(3.5rem, 7vw, 7rem); }
  .possibilities__header h2 { margin: 1.15rem 0 1.35rem; font-size: clamp(3.4rem, 6.4vw, 6.8rem); line-height: .88; letter-spacing: -.018em; font-weight: 400; }
  .possibilities__header h2 em { color: var(--clay); font-weight: 400; }
  .possibilities__header > p:last-child { max-width: 32rem; color: rgba(24,49,41,.73); }
  .possibilities__list { display: grid; gap: clamp(4rem, 8vw, 8rem); }
  .possibility { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(2rem, 6vw, 7rem); align-items: center; color: var(--ink); }
  .possibility--reverse { grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); }
  .possibility--reverse .possibility__image { order: 2; }
  .possibility__image { position: relative; overflow: hidden; border-radius: .3rem; box-shadow: 0 1.25rem 3rem rgba(23,54,45,.1); }
  .possibility__image img { width: 100%; height: clamp(23rem, 36vw, 35rem); object-fit: cover; transition: transform .7s cubic-bezier(.2,.75,.2,1); }
  .possibility:hover .possibility__image img { transform: scale(1.045); }
  .possibility__image span { position: absolute; z-index: 1; bottom: 1rem; left: 1rem; color: var(--paper); font: 500 .62rem/1 var(--font-mono); letter-spacing: .1em; }
  .possibility__copy { max-width: 35rem; }
  .possibility__copy h3 { margin: .85rem 0 1rem; font-size: clamp(2.5rem, 3.8vw, 4.2rem); line-height: .92; letter-spacing: -.012em; font-weight: 400; }
  .possibility__copy > p:not(.eyebrow) { color: rgba(23,54,45,.8); font-size: 1.03rem; line-height: 1.7; }
  .possibility__copy ul { display: flex; flex-wrap: wrap; gap: .45rem .85rem; padding: 1.55rem 0; margin: 1.7rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); list-style: none; }
  .possibility__copy li { font: 500 .58rem/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .possibility__copy li:not(:last-child)::after { content: '·'; margin-left: .85rem; color: var(--clay); }
  .possibility__link { color: var(--clay); font: 500 .65rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .possibility__link b { margin-left: .4rem; font-size: 1rem; font-weight: 400; }
  .steps { display: grid; grid-template-columns: .6fr 1.4fr; gap: clamp(2rem, 5vw, 7rem); padding: clamp(5rem, 10vw, 10rem) var(--page-edge); background: var(--paper); border-top: 1px solid var(--line); }
  .steps__label span { font: 500 .59rem/1 var(--font-mono); letter-spacing: .1em; opacity: .5; }
  .steps__label { display: flex; justify-content: space-between; gap: 1rem; align-items: start; }
  .steps h2 { font-size: clamp(2.7rem, 4.4vw, 4.8rem); line-height: .92; letter-spacing: -.015em; margin-bottom: 2.2rem; font-weight: 400; }
  .steps ol { list-style: none; display: grid; gap: 1.1rem; margin-bottom: 2.2rem; }
  .steps li { max-width: 44rem; padding: 1.3rem 0; border-top: 1px solid var(--line); color: rgba(23,54,45,.82); font-size: 1.02rem; line-height: 1.65; }
  .steps li:last-child { border-bottom: 1px solid var(--line); }
  .steps li strong { color: var(--ink); }
  .objections { padding: clamp(5rem, 10vw, 10rem) var(--page-edge); background: var(--sand); }
  .objections__header { max-width: 54rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .objections__header h2 { margin-top: 1rem; font-size: clamp(2.8rem, 4.6vw, 4.9rem); line-height: .92; letter-spacing: -.015em; font-weight: 400; }
  .objections__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .objections__grid article { border-top: 2px solid var(--clay); padding: 1.2rem 1.2rem 1.35rem; background: rgba(252,250,246,.45); border-radius: 0 0 .25rem .25rem; }
  .objections__grid h3 { font-size: 1.7rem; line-height: .98; letter-spacing: -.02em; margin-bottom: .8rem; }
  .objections__grid p { font-size: .97rem; line-height: 1.6; color: rgba(23,54,45,.78); }
  .objections__link { display: inline-block; margin-top: 2.2rem; color: var(--clay); font: 500 .65rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; border-bottom: 1px solid var(--clay); padding-bottom: .25rem; }
  .estate-assembly { display: grid; grid-template-columns: .76fr 1.24fr; gap: clamp(3rem, 9vw, 12rem); padding: clamp(5.5rem, 11vw, 12rem) var(--page-edge); background: var(--ink); color: var(--paper); }
  .estate-assembly__heading { max-width: 33rem; }
  .estate-assembly__heading h2 { margin: 1rem 0 1.45rem; font-size: clamp(3.1rem, 4.8vw, 5.2rem); line-height: .9; letter-spacing: -.018em; font-weight: 400; }
  .estate-assembly__heading > p:last-child { color: rgba(246,242,231,.72); }
  .estate-assembly__heading .button { margin-top: 1.8rem; }
  .estate-assembly__photos { min-height: 33rem; display: grid; grid-template-columns: .8fr 1fr; grid-template-rows: 1fr 1fr; gap: .85rem; }
  .estate-assembly__photo { position: relative; overflow: hidden; border-radius: .25rem; }
  .estate-assembly__photo img { width: 100%; height: 100%; object-fit: cover; }
  .estate-assembly__photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(15,33,28,.7), transparent 45%); }
  .estate-assembly__photo figcaption { position: absolute; z-index: 1; left: .85rem; bottom: .8rem; color: var(--paper); font: 500 .56rem/1.3 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; }
  .estate-assembly__photo--pool { grid-row: span 2; }
  .estate-assembly__photo--factory { grid-column: 2; }
  .proof { display: grid; grid-template-columns: .9fr 1.1fr; min-height: 52rem; }
  .proof__figure { overflow: hidden; position: relative; background: var(--clay); }
  .proof__figure img { width: 100%; height: 100%; object-fit: cover; filter: sepia(.14) contrast(.9); mix-blend-mode: multiply; }
  .proof__figure span { position: absolute; left: 1.5rem; bottom: 1.5rem; color: var(--ink); font: 500 .58rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .proof__content { align-self: center; padding: clamp(4rem, 10vw, 10rem) var(--page-edge); }
  .proof__content h2 { margin: 1rem 0 1.35rem; font-size: clamp(3rem, 4.6vw, 5.2rem); line-height: .9; letter-spacing: -.018em; font-weight: 400; }
  .proof__content h2 em { color: var(--clay); font-weight: 400; }
  .proof__content > p:not(.eyebrow) { max-width: 31rem; color: rgba(23,54,45,.78); margin-bottom: 1.8rem; line-height: 1.7; }
  .proof__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .proof__quiet-link { color: var(--clay); font: 500 .64rem/1.4 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; border-bottom: 1px solid var(--clay); padding-bottom: .2rem; }
  .location-band { display: grid; grid-template-columns: .55fr 1.25fr .45fr; gap: 2rem; align-items: start; padding: clamp(4rem, 8vw, 8rem) var(--page-edge); background: var(--ochre); color: var(--ink-deep); }
  .location-band h2 { font-size: clamp(2.8rem, 4.4vw, 4.8rem); line-height: .92; letter-spacing: -.015em; font-weight: 400; }
  .location-band p:not(.eyebrow) { max-width: 37rem; margin-top: 1.1rem; }
  .location-band__cta { display: inline-block; margin-top: 1.5rem; font: 500 .65rem/1.4 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; border-bottom: 1px solid var(--ink-deep); padding-bottom: .25rem; }
  .location-band__marker { justify-self: end; display: grid; place-content: center; width: 7.5rem; height: 7.5rem; border: 1px solid rgba(15,33,28,.5); border-radius: 50%; text-align: center; font: 500 .61rem/1.5 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; }
  .location-band__marker i { font-style: normal; opacity: .6; }
  @keyframes reveal-image { from { transform: scale(1.07); } to { transform: scale(1); } }
  @keyframes rise-in { from { opacity: 0; transform: translateY(1.5rem); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 900px) { .fact-strip { grid-template-columns: repeat(4, 1fr); padding: 0 1.5rem; } .fact-strip > p { grid-column: 1 / -1; padding: 1.2rem 0 .35rem; } .manifesto { grid-template-columns: 1fr 1.25fr; } .manifesto__image { grid-column: 2; margin-top: 0; max-width: 25rem; } .estate-assembly, .proof { grid-template-columns: 1fr; } .estate-assembly__photos { min-height: 38rem; } .proof { min-height: 0; } .proof__figure { height: 28rem; } .proof__content { padding: 5rem var(--page-edge); } .steps { grid-template-columns: 1fr; } .objections__grid { grid-template-columns: 1fr 1fr; } }
