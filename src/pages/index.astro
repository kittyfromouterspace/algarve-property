---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import EnquiryPanel from '../components/EnquiryPanel.astro';
import { estateFacts, property } from '../data/property';

// All internal CTA links carry the family-pivot campaign parameters.
const campaign = 'utm_source=site&utm_medium=cta&utm_campaign=family-pivot';
const internal = (path: string) => `${path}?${campaign}`;

// WhatsApp number is taken from the property data — unchanged from the live site.
const waNumber = (property.contact.phone ?? '').replace(/[^0-9]/g, '');
const whatsapp = (text: string) => `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;
const walkthroughUrl = whatsapp("Olá Lenz, I'd like a live video walkthrough of the family estate at Quinta Fonte do Palheiro.");
const coBuyUrl = whatsapp('Olá Lenz, we would like to ask about two families buying Quinta Fonte do Palheiro together.');
const emailUrl = `mailto:${property.contact.email}`;

// No unverified figures are published. See the <!-- VERIFY --> block below for the policy
// and for where to put confirmed values if any of these details are added back later.
---

<Layout
  title="Family estate in the Algarve: two houses, 2.5 ha, under €900k | Quinta Fonte do Palheiro"
  description="Two independent furnished houses on 2.5 ha near Salir, Loulé. Room for three generations or two families. Saltwater pool, own water, 3-phase power, 11 kW EV charger and home office, 45 min from Faro. Asking €890,000. Book a live video walkthrough."
  ogImage="/images/og-family.jpg"
  ogImageAlt="The swimming pool at sunset at Quinta Fonte do Palheiro, Algarve"
>
  <SiteHeader ctaHref="#enquire" />
  <main id="main">
    <!-- VERIFY — no unverified specifics are published on this page.
         Removed before release: Nobel Algarve and CIV Vilamoura drive times, the Faro
         healthcare drive time, the "200–300 Mbps" Starlink figure and the "fibre ~500 m
         away" claim. If any of these are added back, record the confirmed value and its
         source in this block first, then reflect it in the FAQ. Until then the FAQ gives
         general guidance and points to a live speed test on the video walkthrough. -->
    <section class="hero">
      <img class="hero__image" src="/images/areal1.jpg" alt="Aerial view of Quinta Fonte do Palheiro and the Algarve hills" width="1600" height="1200" fetchpriority="high" decoding="async" />
      <div class="hero__veil"></div>
      <div class="hero__content">
        <p class="eyebrow eyebrow--light">Salir, Loulé · Algarve · €890,000</p>
        <h1>Two houses.<br />One estate.<br /><em>Room for everyone.</em></h1>
        <p class="hero__statement">A 2.5-hectare family estate above Salir: a furnished three-bedroom main house, a second independent furnished house, a saltwater pool and ten-plus buildings with their own water. Asking €890,000 — under €900k — for a place that already works.</p>
        <div class="hero__actions">
          <a class="button button--ochre" data-event="Walkthrough click" data-label="Hero CTA" href={walkthroughUrl} target="_blank" rel="noopener">Book a live video walkthrough <span aria-hidden="true">↗</span></a>
          <a class="hero__quiet-link" href="#stories">Meet the three family stories <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero__reassurance">Live video tours weekly · reply within 48 hours · buyer-facts brief before you fly</p>
      </div>
      <div class="hero__price"><span>Asking price · under €900k</span><strong>€890,000</strong></div>
      <div class="hero__location">37° N · Algarve hills<br />45 min · Faro airport</div>
    </section>

    <section id="stories" class="stories" aria-label="Three family stories">
      <header class="stories__header">
        <p class="eyebrow">Three family stories</p>
        <h2>One estate.<br /><em>Three ways to make it home.</em></h2>
        <p>Real buyers here are families looking for a place to gather, not a business to run. These are the three shapes we see most often. None of them starts with a construction project.</p>
      </header>
      <div class="stories__list">
        <article class="story">
          <figure class="story__image">
            <img src="/images/main-house-outside-dining.JPG" alt="Outdoor dining table beside the pool and the main house" width="1201" height="1600" loading="lazy" decoding="async" />
            <figcaption>01 · Gather · the outdoor table</figcaption>
          </figure>
          <div class="story__copy">
            <p class="eyebrow">Multigenerational living</p>
            <h3>Together,<br /><em>but private.</em></h3>
            <p>A three-bedroom main house and a separate furnished second house give grandparents, grown-up children or a live-in helper their own front door and kitchen — while everyone still meets at the pool or the outdoor table.</p>
            <p>Two houses on 2.5 ha mean quiet when you want it and company when you do not. The meditation house, bar and workshop stay available as shared spaces, not obligations.</p>
            <ul>
              <li>Two independent furnished houses</li>
              <li>Shared pool and terrace</li>
              <li>Ten-plus buildings to spread out in</li>
            </ul>
            <a class="story__link" data-event="Walkthrough click" data-label="Story 1 – multigenerational" href={walkthroughUrl} target="_blank" rel="noopener">See both houses live <b aria-hidden="true">↗</b></a>
          </div>
        </article>

        <article class="story story--reverse">
          <figure class="story__image">
            <img src="/images/small-house-and-office1.jpg" alt="The separate second house with its own entrance and garden" width="1600" height="900" loading="lazy" decoding="async" />
            <figcaption>02 · Privacy · the second house</figcaption>
          </figure>
          <div class="story__copy">
            <p class="eyebrow">Buy with friends</p>
            <h3>Two families.<br /><em>One shared address.</em></h3>
            <p>Both houses already stand on the estate, which makes a shared purchase unusually practical: one family in the main house, the other in the second. Each keeps a front door and a garden; together you share the pool, bar and 2.5 ha of ridge.</p>
            <div class="math-card">
              <div><span>Asking price</span><strong>€890,000</strong></div>
              <span class="math-card__operator" aria-hidden="true">÷ 2</span>
              <div><span>Per family</span><strong>€445,000</strong></div>
            </div>
            <p class="math-card__note">Less than a standard Algarve villa per family. Legal, tax and financing costs are extra — take independent advice before you decide.</p>
            <p>Ownership can be held as compropriedade (joint ownership) or through a company. Both need a Portuguese lawyer to set up properly. Our co-buying guide lists the questions to take to that first meeting.</p>
            <div class="story__actions">
              <a class="button" data-event="Co-buy click" data-label="Co-buying guide" href={internal('/co-buying-guide')}>Read the co-buying guide <span aria-hidden="true">↗</span></a>
              <a class="story__link" data-event="Co-buy click" data-label="Co-buying WhatsApp" href={coBuyUrl} target="_blank" rel="noopener">Ask us about co-buying <b aria-hidden="true">↗</b></a>
            </div>
          </div>
        </article>

        <article class="story">
          <figure class="story__image">
            <img src="/images/pool4.JPG" alt="Saltwater pool and shaded gazebo at Quinta Fonte do Palheiro" width="1600" height="1201" loading="lazy" decoding="async" />
            <figcaption>03 · Settle in · pool and gazebo</figcaption>
          </figure>
          <div class="story__copy">
            <p class="eyebrow">A ready-made landing</p>
            <h3>Arrive with a suitcase.<br /><em>Stay for good.</em></h3>
            <p>For a later-stage family — the children grown, work more flexible — the estate is already set up for daily life. Both houses are furnished, the saltwater pool is there, the second house has its own office, and the internet works well enough for remote days.</p>
            <p>Three-phase power, an 11 kW EV charger and the estate's own water take care of the unglamorous things. The workshop, bar and meditation house are there when you want them, not a project waiting for permission.</p>
            <ul>
              <li>Furnished houses</li>
              <li>Saltwater pool</li>
              <li>Own water</li>
              <li>3-phase power</li>
              <li>11 kW EV charger</li>
              <li>Home office</li>
            </ul>
            <a class="story__link" data-event="Walkthrough click" data-label="Story 3 – ready-made landing" href={walkthroughUrl} target="_blank" rel="noopener">Walk it on video <b aria-hidden="true">↗</b></a>
          </div>
        </article>
      </div>
    </section>

    <section class="fact-strip" aria-label="Estate facts">
      {estateFacts.map((fact) => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
    </section>

    <section class="family-faq" aria-label="Family FAQ">
      <div class="family-faq__inner">
        <div class="family-faq__intro">
          <p class="eyebrow">Family FAQ</p>
          <h2>The questions families<br /><em>actually ask.</em></h2>
          <p>Straight answers, including the ones that are harder to pin down. Where we cannot verify a number, we say so and show you how to check it yourself before you spend money on flights or lawyers.</p>
          <a class="button" data-event="FAQ click" data-label="All buyer facts" href={internal('/buyer-facts')}>All buyer facts <span aria-hidden="true">↗</span></a>
        </div>
        <div class="faq-list">
          <details>
            <summary data-event="FAQ open" data-faq data-label="International schools">How far are the international schools?</summary>
            <div class="answer">
              <p>Families usually ask about international schools in the Loulé and Vilamoura area. We would rather not quote drive times we cannot verify: ask each school about bus routes, admissions and term dates, and ask us on the video call to put you in touch with local parents so you can judge the commute for yourselves.</p>
            </div>
          </details>
          <details>
            <summary data-event="FAQ open" data-faq data-label="Healthcare">What is healthcare nearby?</summary>
            <div class="answer">
              <p>There is local primary care in the Salir and Loulé area, with hospital care in Faro. We do not quote drive times or waiting times: they depend on your provider, insurer and the day you travel. Confirm services and cover with your insurer, and ask us anything specific on the call.</p>
            </div>
          </details>
          <details>
            <summary data-event="FAQ open" data-faq data-label="Internet and working">Can we actually work from here?</summary>
            <div class="answer">
              <p>People live and work online here, and the second house has its own office. We will run a live speed test on the walkthrough so you can judge the connection yourself rather than relying on a number in a brochure. Ask us to confirm current broadband options with the operator before you rely on them. Three-phase power covers a workshop or studio without an upgrade.</p>
            </div>
          </details>
          <details>
            <summary data-event="FAQ open" data-faq data-label="Terrain and children">The land is steep — is it safe for kids?</summary>
            <div class="answer">
              <p>Parts of it are, and we would rather say so up front. Treat the hillside as adventure rather than a flat lawn. On the video walkthrough we will show the level areas around the houses, any gated or fenced sections, the pool terrace and the paths, and talk through pool safety and sightlines. Judge it with your own eyes before you fly.</p>
            </div>
          </details>
          <details>
            <summary data-event="FAQ open" data-faq data-label="Daily logistics">What does daily life involve?</summary>
            <div class="answer">
              <p>About 15 minutes to the supermarket, 45 to Faro Airport and 40 to the nearest beach. A paved public road reaches the gate, so deliveries, trades and visitors arrive year-round. The houses and land are private-zoned; the former workshop is commercially zoned — confirm any business use with Loulé Council.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <section id="possibilities" class="other-possibilities" aria-label="Other possibilities">
      <p class="eyebrow">Other possibilities</p>
      <h2>Different frame,<br /><em>same estate.</em></h2>
      <p>Family living is the front door now. If your plan is still a retreat, a tourism business or a more self-sufficient life, those routes have their own pages and their own numbers.</p>
      <div class="other-possibilities__links">
        <a data-event="Other possibilities click" data-label="Retreat venue" href={internal('/retreat-venue')}>Retreat venue <b aria-hidden="true">↗</b></a>
        <a data-event="Other possibilities click" data-label="Rural tourism" href={internal('/rural-tourism-business')}>Rural tourism <b aria-hidden="true">↗</b></a>
        <a data-event="Other possibilities click" data-label="Independent living" href={internal('/independent-living')}>Independent / off-grid living <b aria-hidden="true">↗</b></a>
      </div>
    </section>

    <section class="inventory" aria-label="What is included">
      <div class="inventory__intro">
        <p class="eyebrow eyebrow--light">What is included</p>
        <h2>An honest<br /><em>inventory.</em></h2>
        <p>Furnishings in both houses, the 11 kW EV charger, the three-phase installation and the own-water infrastructure represent roughly €55–85k in replacement value as they stand. That is a working estimate, not a formal valuation. The exact list is agreed in writing as part of the sale.</p>
        <a class="button button--paper" data-event="Walkthrough click" data-label="Inventory CTA" href={walkthroughUrl} target="_blank" rel="noopener">Ask for the itemised list <span aria-hidden="true">↗</span></a>
      </div>
      <div class="inventory__detail">
        <div class="inventory__value"><span>Approximate included value</span><strong>€55–85k</strong><small>Replacement value, not an appraisal</small></div>
        <ul>
          <li>Furnished rooms in both houses</li>
          <li>11 kW Type 2 EV charger, installed</li>
          <li>Three-phase power throughout</li>
          <li>Own borehole, storage and water infrastructure</li>
          <li>Saltwater pool, meditation house, bar and workshop buildings</li>
        </ul>
      </div>
    </section>

    <Gallery images={property.gallery} />
    <EnquiryPanel />
  </main>
  <SiteFooter />
</Layout>

<style>
  .hero { min-height: min(56rem, 100svh); position: relative; isolation: isolate; display: flex; align-items: end; overflow: hidden; padding: 10rem var(--page-edge) 5.5rem; color: var(--paper); background: var(--ink); }
  .hero__image { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 56%; animation: reveal-image 1.6s cubic-bezier(.2,.75,.2,1) both; }
  .hero__veil { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgba(8,28,21,.88), rgba(8,28,21,.46) 54%, rgba(8,28,21,.1)), linear-gradient(0deg, rgba(8,28,21,.64), transparent 50%); }
  .hero__content { max-width: 48rem; animation: rise-in 1.1s .25s cubic-bezier(.2,.75,.2,1) both; }
  .hero h1 { margin: 1.25rem 0 1.5rem; font-size: clamp(3.6rem, 7vw, 7.6rem); line-height: .89; letter-spacing: -.018em; font-weight: 400; }
  .hero h1 em { color: var(--ochre); font-weight: 400; }
  .hero__statement { max-width: 39rem; font-size: clamp(1.02rem, 1.3vw, 1.18rem); line-height: 1.62; color: rgba(252,250,246,.9); }
  .hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.2rem 1.6rem; margin-top: 2.15rem; }
  .hero__quiet-link { color: var(--paper); font: 500 .64rem/1.4 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; border-bottom: 1px solid rgba(246,242,231,.48); padding-bottom: .2rem; }
  .hero__quiet-link:hover { color: var(--ochre); border-color: var(--ochre); }
  .hero__reassurance { margin-top: 1.4rem; font: 500 .6rem/1.6 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; color: rgba(246,242,231,.66); }
  .hero__price { position: absolute; right: var(--page-edge); bottom: 5.5rem; padding: 1rem 0 1rem 1.2rem; border-left: 1px solid var(--ochre); text-align: right; background: linear-gradient(90deg, transparent, rgba(13,37,30,.24)); }
  .hero__price span, .hero__price strong { display: block; }
  .hero__price span, .hero__location { font: 500 .58rem/1.5 var(--font-mono); letter-spacing: .11em; text-transform: uppercase; }
  .hero__price strong { margin-top: .25rem; color: var(--ochre); font: 400 clamp(1.7rem, 2.6vw, 2.6rem)/1 var(--font-display); letter-spacing: -.04em; }
  .hero__location { position: absolute; left: var(--page-edge); bottom: 1.25rem; opacity: .75; }

  .stories { padding: clamp(5.5rem, 11vw, 12rem) var(--page-edge); }
  .stories__header { max-width: 56rem; padding-bottom: clamp(3.5rem, 7vw, 7rem); }
  .stories__header h2 { margin: 1.15rem 0 1.35rem; font-size: clamp(3rem, 5.4vw, 6rem); line-height: .9; letter-spacing: -.018em; font-weight: 400; }
  .stories__header h2 em { color: var(--clay); font-weight: 400; }
  .stories__header > p:last-child { max-width: 34rem; color: rgba(24,49,41,.73); }
  .stories__list { display: grid; gap: clamp(4rem, 8vw, 8rem); }
  .story { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(2rem, 6vw, 7rem); align-items: center; color: var(--ink); }
  .story--reverse { grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); }
  .story--reverse .story__image { order: 2; }
  .story__image { position: relative; overflow: hidden; border-radius: .3rem; box-shadow: 0 1.25rem 3rem rgba(23,54,45,.1); }
  .story__image img { width: 100%; height: clamp(23rem, 36vw, 35rem); object-fit: cover; transition: transform .7s cubic-bezier(.2,.75,.2,1); }
  .story:hover .story__image img { transform: scale(1.045); }
  .story__image figcaption { position: absolute; z-index: 1; bottom: 1rem; left: 1rem; color: var(--paper); font: 500 .62rem/1 var(--font-mono); letter-spacing: .1em; text-shadow: 0 1px 6px rgba(0,0,0,.55); }
  .story__copy { max-width: 36rem; }
  .story__copy h3 { margin: .85rem 0 1rem; font-size: clamp(2.6rem, 3.8vw, 4.2rem); line-height: .92; letter-spacing: -.012em; font-weight: 400; }
  .story__copy h3 em { color: var(--clay); font-weight: 400; }
  .story__copy > p:not(.eyebrow):not(.math-card__note) { color: rgba(23,54,45,.8); font-size: 1.03rem; line-height: 1.7; }
  .story__copy ul { display: flex; flex-wrap: wrap; gap: .45rem .85rem; padding: 1.55rem 0; margin: 1.7rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); list-style: none; }
  .story__copy li { font: 500 .58rem/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .story__copy li:not(:last-child)::after { content: '·'; margin-left: .85rem; color: var(--clay); }
  .story__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.6rem; }
  .story__link { color: var(--clay); font: 500 .65rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .story__link:hover { color: var(--ink); }
  .story__link b { margin-left: .4rem; font-size: 1rem; font-weight: 400; }
  .math-card { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; margin: 1.7rem 0 .85rem; padding: 1.35rem 1.4rem; border: 1px solid var(--line); border-radius: .3rem; background: rgba(238,231,220,.5); }
  .math-card div span, .math-card div strong { display: block; }
  .math-card div span { font: 500 .58rem/1.3 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: rgba(23,54,45,.66); }
  .math-card div strong { margin-top: .35rem; font: 400 clamp(1.9rem, 2.8vw, 3rem)/1 var(--font-display); letter-spacing: -.04em; }
  .math-card__operator { font: 400 1.4rem/1 var(--font-display); color: var(--clay); }
  .math-card__note { margin: 0 0 1.5rem; max-width: 34rem; font-size: .88rem; line-height: 1.55; color: rgba(23,54,45,.7); }

  .fact-strip { background: var(--ochre); color: var(--ink-deep); min-height: 8rem; display: grid; grid-template-columns: repeat(6, 1fr); align-items: stretch; padding: 0 var(--page-edge); }
  .fact-strip > div { padding: 1.3rem 1rem; display: flex; flex-direction: column; justify-content: center; border-left: 1px solid rgba(15,33,28,.28); }
  .fact-strip > div:nth-child(6n+1) { border-left: 0; padding-left: 0; }
  .fact-strip strong { font: 400 clamp(1.5rem, 2.2vw, 2.4rem)/.95 var(--font-display); letter-spacing: -.04em; }
  .fact-strip span { margin-top: .4rem; font: 500 .57rem/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }

  .family-faq { padding: clamp(5rem, 10vw, 10rem) var(--page-edge); background: var(--sand); }
  .family-faq__inner { display: grid; grid-template-columns: .72fr 1.28fr; gap: clamp(2.5rem, 7vw, 8rem); align-items: start; }
  .family-faq__intro { max-width: 30rem; }
  .family-faq__intro h2 { margin: 1rem 0 1.4rem; font-size: clamp(2.8rem, 4.4vw, 4.8rem); line-height: .93; letter-spacing: -.015em; font-weight: 400; }
  .family-faq__intro h2 em { color: var(--clay); font-weight: 400; }
  .family-faq__intro > p:last-of-type { margin-bottom: 1.8rem; color: rgba(24,49,41,.76); }
  .faq-list details { border-top: 1px solid var(--line); }
  .faq-list details:last-child { border-bottom: 1px solid var(--line); }
  .faq-list summary { cursor: pointer; list-style: none; position: relative; padding: 1.35rem 2.5rem 1.35rem 0; font: 400 clamp(1.25rem, 1.8vw, 1.65rem)/1.2 var(--font-display); letter-spacing: -.01em; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after { content: '+'; position: absolute; right: .2rem; top: 1.1rem; color: var(--clay); font: 400 1.4rem/1 var(--font-body); transition: transform .2s ease; }
  .faq-list details[open] summary::after { transform: rotate(45deg); }
  .faq-list .answer { padding: 0 0 1.5rem; max-width: 42rem; color: rgba(23,54,45,.8); font-size: .98rem; line-height: 1.65; }
  .faq-list .answer b { color: var(--ink); }

  .other-possibilities { padding: clamp(3.5rem, 6vw, 5.5rem) var(--page-edge); border-top: 1px solid var(--line); background: var(--paper); }
  .other-possibilities h2 { margin: 1rem 0 .9rem; font-size: clamp(2rem, 3vw, 3.2rem); line-height: .95; letter-spacing: -.015em; font-weight: 400; }
  .other-possibilities h2 em { color: var(--clay); font-weight: 400; }
  .other-possibilities > p:not(.eyebrow) { max-width: 38rem; color: rgba(23,54,45,.75); }
  .other-possibilities__links { display: flex; flex-wrap: wrap; gap: .8rem 2rem; margin-top: 1.8rem; }
  .other-possibilities__links a { color: var(--clay); font: 500 .65rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; border-bottom: 1px solid var(--clay); padding-bottom: .25rem; }
  .other-possibilities__links a:hover { color: var(--ink); border-color: var(--ink); }
  .other-possibilities__links b { margin-left: .3rem; font-weight: 400; }

  .inventory { display: grid; grid-template-columns: 1fr .9fr; gap: clamp(3rem, 8vw, 10rem); padding: clamp(5rem, 10vw, 10rem) var(--page-edge); background: var(--ink); color: var(--paper); }
  .inventory__intro { max-width: 34rem; }
  .inventory__intro h2 { margin: 1rem 0 1.45rem; font-size: clamp(3rem, 4.8vw, 5.2rem); line-height: .9; letter-spacing: -.018em; font-weight: 400; }
  .inventory__intro h2 em { color: var(--ochre); font-weight: 400; }
  .inventory__intro > p:last-of-type { color: rgba(246,242,231,.76); }
  .inventory__intro .button { margin-top: 1.8rem; }
  .inventory__value { padding: 0 0 1.6rem; border-bottom: 1px solid rgba(252,250,246,.3); }
  .inventory__value span, .inventory__value small { display: block; font: 500 .58rem/1.5 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: rgba(246,242,231,.7); }
  .inventory__value strong { display: block; margin: .5rem 0 .6rem; color: var(--ochre); font: 400 clamp(3rem, 5vw, 5rem)/.9 var(--font-display); letter-spacing: -.05em; }
  .inventory ul { list-style: none; margin-top: 1.4rem; }
